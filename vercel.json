{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install --prefix web",
  "buildCommand": "npm run build --prefix web",
  "outputDirectory": "web/.next",
  "crons": [
    {
      "path": "/api/campaigns/tick",
      "schedule": "30 3 * * *"
    }
  ]
}
