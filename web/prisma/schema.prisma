// FinBud AI — single-company AI voice calling platform.
//
// Deliberately single-tenant: there is no Organization table and no
// organizationId on any row. Every record belongs to the one company running
// this deployment, which removes a join and a filter from every query.
//
// Two roles only: admin and employee. See User.role.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// People & access
// ---------------------------------------------------------------------------

enum Role {
  /// The platform owner. Belongs to no company and sees across all of them.
  /// Deliberately a role rather than a flag, so one authorisation path covers
  /// every caller instead of two that can disagree.
  super_admin
  /// Company administrator. Kept as `admin` rather than renamed to
  /// COMPANY_ADMIN: every existing guard compares against this value, and a
  /// rename is a breaking migration bought for nothing.
  admin
  manager
  /// The calling agent. Kept as `employee` for the same reason as `admin`.
  employee
  viewer
}

/// Where a company is in its life on the platform.
enum CompanyStatus {
  /// Requested access, not yet approved. Cannot sign in.
  pending
  active
  /// Suspended by the platform owner — data retained, access refused.
  suspended
}

enum UserStatus {
  invited // created by an admin, has not set a password yet
  active
  disabled
}

// ---------------------------------------------------------------------------
// The tenant.
//
// Every row that belongs to somebody hangs off this. The platform owner
// (Role.super_admin) has no company and sees across all of them; everyone else
// has exactly one, derived from their session and never from the request.
//
// Isolation is not a filter that each route remembers to apply. lib/authz.ts
// builds the where-fragments and every query composes them, so a new route that
// forgets is a route that returns nothing rather than a route that leaks.
// ---------------------------------------------------------------------------
model Company {
  id   String @id @default(uuid())
  name String

  /// URL-safe handle, for a per-company sign-in path or subdomain later.
  slug String @unique

  status CompanyStatus @default(pending)

  // --- who asked, kept from the access request so approval has context -----
  contactName  String?
  contactEmail String?
  contactPhone String?
  /// Free text from the access request — what they said they needed.
  requestNotes String?

  // --- branding -------------------------------------------------------------
  /// Applied as CSS custom properties at render, so a company's colours reach
  /// every component without any of them naming a colour.
  theme    Json?
  logoUrl  String?

  // --- limits ---------------------------------------------------------------
  /// Null means "no ceiling". Nullable rather than a sentinel number so
  /// "unlimited" cannot be confused with "zero", which is the failure mode that
  /// silently blocks a paying customer.
  maxUsers        Int?
  maxAgents       Int?
  maxCampaigns    Int?
  maxContacts     Int?
  maxCallsPerDay  Int?
  maxCallMinutes  Int?
  maxConcurrent   Int?

  /// Plan label. Free text for now: the plan catalogue is a later phase, and a
  /// foreign key to a table that does not exist yet would block this one.
  plan String?

  // --- per-company provider credentials -------------------------------------
  /// A company's own OmniDimension key, encrypted at rest. Null falls back to
  /// the platform key, which is how the founding company keeps working
  /// unchanged through this migration.
  omnidimApiKeyEnc String?
  /// The number their calls dial from, once they import one.
  fromNumberId     String?

  approvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  users            User[]
  invites          Invite[]
  agents           Agent[]
  contacts         Contact[]
  campaigns        Campaign[]
  calls            Call[]
  notes            Note[]
  documents        Document[]
  messageTemplates MessageTemplate[]
  messages         Message[]
  auditLogs        AuditLog[]
  findings         CallFinding[]
  settings         CompanySetting[]

  // Billing
  subscriptions Subscription[]
  invoices      Invoice[]
  payments      Payment[]
  refunds       Refund[]

  @@index([status])
}

/// Per-company key/value settings.
///
/// The existing global `Setting` table stays for platform-wide values. This is
/// its tenant-scoped twin — the provider credential fingerprint, for one, is
/// per-account and therefore per-company once each brings its own key.
model CompanySetting {
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  key       String
  value     Json
  updatedAt DateTime @updatedAt

  @@id([companyId, key])
}

model User {

  /// The tenant this row belongs to.
  ///
  /// Required, deliberately: a nullable column let a create quietly omit it,
  /// and such a row is invisible to every scope while — because NULL never
  /// collides in a Postgres unique index — still slipping past the composite
  /// uniques. Required makes each omission a compile error instead.
  companyId String
  tenant    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  id    String @id @default(uuid())
  email String @unique
  name  String

  /// Company employee number. Optional, but unique when set — staff sign in
  /// with either this or their email address.
  employeeId String?
  role       Role       @default(employee)
  status     UserStatus @default(invited)

  // Basic contact/profile fields (a fuller HR profile is future work).
  phone       String?
  department  String?
  designation String?

  // Null until the user completes the invite / sets a password.
  passwordHash String?

  // True while the account still has the admin-assigned default password.
  // The user is forced to /change-password and blocked from every dashboard
  // page until they choose their own.
  mustChangePassword Boolean @default(false)

  // Guardrail: employees can trigger calls, which costs money.
  // Null means "use the global default" from Setting.
  dailyCallLimit Int?

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  invitesSent      Invite[]   @relation("InvitedBy")
  assignedContacts Contact[]  @relation("AssignedTo")
  callsStarted     Call[]     @relation("StartedBy")
  campaigns        Campaign[] @relation("CampaignCreatedBy")
  agents           Agent[]    @relation("AgentCreatedBy")
  documents        Document[] @relation("UploadedBy")
  notes            Note[]
  auditLogs        AuditLog[]
  templates        MessageTemplate[] @relation("TemplateCreatedBy")
  messagesSent     Message[]         @relation("MessageSentBy")
  findingsReviewed CallFinding[]
  paymentsRecorded Payment[]         @relation("PaymentRecordedBy")
  refundsProcessed Refund[]          @relation("RefundProcessedBy")

  @@index([role, status])

  /// Employee ids are assigned per company, so FB-001 exists in every one of
  /// them. Globally unique would make the second company unable to number
  /// its own staff.
  @@unique([companyId, employeeId])
  @@index([companyId, role])
}

/// A pending invitation. The raw token is emailed via Resend and never stored —
/// only its hash, so a database leak cannot be used to claim accounts.
model Invite {

  /// The tenant this row belongs to.
  ///
  /// Required, deliberately: a nullable column let a create quietly omit it,
  /// and such a row is invisible to every scope while — because NULL never
  /// collides in a Postgres unique index — still slipping past the composite
  /// uniques. Required makes each omission a compile error instead.
  companyId String
  tenant    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  id        String   @id @default(uuid())
  email     String
  role      Role     @default(employee)
  tokenHash String   @unique
  expiresAt DateTime

  acceptedAt  DateTime?
  invitedById String?
  invitedBy   User?     @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Agents
// ---------------------------------------------------------------------------

model Agent {

  /// The tenant this row belongs to.
  ///
  /// Required, deliberately: a nullable column let a create quietly omit it,
  /// and such a row is invisible to every scope while — because NULL never
  /// collides in a Postgres unique index — still slipping past the composite
  /// uniques. Required makes each omission a compile error instead.
  companyId String
  tenant    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  id          String  @id @default(uuid())
  name        String
  description String?
  isActive    Boolean @default(false)

  // Spoken first on outbound calls. Supports {{customer_name}}.
  firstMessage String?

  /// Whether the opener is personalised per contact, and whether the customer
  /// can talk over it. Both are behaviour of the greeting itself, so they live
  /// beside it rather than in the flow.
  firstMessageDynamic       Boolean @default(true)
  firstMessageInterruptible Boolean @default(false)

  /// The conversational flow: an ordered array of
  /// `{ id, title, body, enabled }`, authored freely in the builder.
  ///
  /// Replaces the fixed eight-field prompt below. Sections are user-defined —
  /// they can be renamed, reordered, switched off without deleting, and added
  /// to — because no fixed set survives contact with a real script. The legacy
  /// columns are retained so existing agents keep working and can be migrated
  /// lazily; lib/providers/index.ts reads flowSections first and falls back.
  flowSections Json?

  // Legacy fixed prompt fields. Superseded by flowSections; still read when an
  // agent predates it.
  systemPrompt       String?
  businessContext    String?
  callObjective      String?
  qualificationRules String?
  objectionHandling  String?
  complianceRules    String?
  closingScript      String?

  /// Which voice engine executes this agent's calls: livekit | omnidimension | mock.
  /// The app never depends on a specific one — see lib/providers.
  voiceProvider String @default("livekit")

  /// The provider's own id for this agent, stored after we sync it out.
  /// Null until the first successful sync.
  externalAgentId String?

  /// Last successful sync to the provider, and the last error if it failed.
  syncedAt   DateTime?
  syncError  String?

  // Model identifiers, e.g. "openai/gpt-4o-mini".
  llmModel String  @default("openai/gpt-4o-mini")
  sttModel String  @default("deepgram/nova-3")
  ttsModel String  @default("cartesia/sonic-3")
  voiceId  String?
  language String  @default("multi")

  transferEnabled Boolean @default(false)
  transferNumber  String?

  /// Hard ceiling on one call, in seconds, enforced by the voice engine.
  ///
  /// Telephony and model time are billed per minute, so a call that fails to
  /// end — a hold queue, an answering machine, a customer who puts the phone
  /// down without hanging up — burns credit until someone notices. Five minutes
  /// is longer than any qualification call needs.
  maxCallSeconds Int @default(300)

  /// Seconds of silence before the agent prompts, then gives up and ends the
  /// call. Without this a dead line stays open for the full maxCallSeconds.
  idleTimeoutSeconds Int @default(10)

  /// When true the worker retrieves knowledge-base context during calls.
  useKnowledgeBase Boolean @default(false)

  createdById String?
  createdBy   User?   @relation("AgentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns Campaign[]
  calls     Call[]

  @@index([isActive])
}

// ---------------------------------------------------------------------------
// Contacts
// ---------------------------------------------------------------------------

enum ContactStatus {
  pending // never attempted
  calling // a call is in flight
  retry // failed/no answer, scheduled for another attempt
  completed
  exhausted // retry limit reached
  do_not_call
}

model Contact {

  /// The tenant this row belongs to.
  ///
  /// Required, deliberately: a nullable column let a create quietly omit it,
  /// and such a row is invisible to every scope while — because NULL never
  /// collides in a Postgres unique index — still slipping past the composite
  /// uniques. Required makes each omission a compile error instead.
  companyId String
  tenant    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  id      String  @id @default(uuid())
  name    String?
  phone   String
  email   String?
  company String?

  loanType   String?
  loanAmount Float?

  status       ContactStatus @default(pending)
  tags         String[]      @default([])
  /// Arbitrary extra columns preserved from an imported spreadsheet.
  customFields Json?

  assignedToId String?
  assignedTo   User?   @relation("AssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  // Retry bookkeeping for the campaign runner.
  attempts      Int       @default(0)
  lastAttemptAt DateTime?
  nextAttemptAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  calls    Call[]
  notes    Note[]
  messages Message[]
  findings CallFinding[]

  /// One row per phone number PER COMPANY. Globally unique would mean the
  /// first tenant to import a lead permanently blocks every other tenant from
  /// holding it — and two companies calling the same person is ordinary. The
  /// re-import-updates-rather-than-duplicates behaviour this was written for
  /// still holds, now scoped to the owner.
  @@unique([companyId, phone])
  @@index([status, nextAttemptAt])
  @@index([assignedToId])
  @@index([campaignId])
}

// ---------------------------------------------------------------------------
// Campaigns
// ---------------------------------------------------------------------------

enum CampaignStatus {
  draft
  scheduled
  running
  paused
  completed
}

model Campaign {

  /// The tenant this row belongs to.
  ///
  /// Required, deliberately: a nullable column let a create quietly omit it,
  /// and such a row is invisible to every scope while — because NULL never
  /// collides in a Postgres unique index — still slipping past the composite
  /// uniques. Required makes each omission a compile error instead.
  companyId String
  tenant    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  id     String         @id @default(uuid())
  name   String
  status CampaignStatus @default(draft)

  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Restrict)

  createdById String?
  createdBy   User?   @relation("CampaignCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // Pacing controls.
  concurrency    Int  @default(1)
  dailyCallLimit Int?
  retryLimit     Int  @default(1)
  retryDelayMins Int  @default(60)

  /// { tz, days:[0-6], start:"09:00", end:"18:00" }
  businessHours Json?
  scheduledAt   DateTime?

  startedAt   DateTime?
  completedAt DateTime?
  lastTickAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts Contact[]
  calls    Call[]

  @@index([status])
}

// ---------------------------------------------------------------------------
// Calls
// ---------------------------------------------------------------------------

enum CallStatus {
  initiated
  ringing
  in_progress
  completed
  failed
}

enum LeadStatus {
  interested
  not_interested
  callback_requested
  no_answer
  voicemail
  unknown
}

model Call {

  /// The tenant this row belongs to.
  ///
  /// Required, deliberately: a nullable column let a create quietly omit it,
  /// and such a row is invisible to every scope while — because NULL never
  /// collides in a Postgres unique index — still slipping past the composite
  /// uniques. Required makes each omission a compile error instead.
  companyId String
  tenant    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  id        String @id @default(uuid())
  phone     String
  direction String @default("outbound")

  /// The caller id the customer saw. Null when the engine does not report one
  /// (LiveKit resolves it inside the SIP trunk), so it is shown as "not
  /// reported" rather than being guessed.
  fromNumber String?

  status CallStatus @default(initiated)

  /// LiveKit room name / SIP call id, used to correlate worker events.
  providerCallId String? @unique

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  agentId String?
  agent   Agent?  @relation(fields: [agentId], references: [id], onDelete: SetNull)

  /// Who triggered it. Null for campaign-driven calls.
  startedById String?
  startedBy   User?   @relation("StartedBy", fields: [startedById], references: [id], onDelete: SetNull)

  durationSec  Int     @default(0)
  recordingUrl String?

  /// Turn-by-turn transcript as [{role, text}].
  transcript     Json?
  transcriptText String?
  summary        String?

  interested     Boolean    @default(false)
  leadStatus     LeadStatus @default(unknown)
  leadScore      Int?
  customerIntent String?
  nextAction     String?
  objections     String?

  /// Populated when a dial fails, so the UI can show a real reason.
  failureReason String?

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  notes    Note[]
  messages Message[]
  findings CallFinding[]

  @@index([status])
  @@index([startedAt])
  @@index([leadStatus])
  @@index([campaignId])
}

/// Employee follow-up: free-text notes and scheduled callbacks.
model Note {

  /// The tenant this row belongs to.
  ///
  /// Required, deliberately: a nullable column let a create quietly omit it,
  /// and such a row is invisible to every scope while — because NULL never
  /// collides in a Postgres unique index — still slipping past the composite
  /// uniques. Required makes each omission a compile error instead.
  companyId String
  tenant    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  id   String @id @default(uuid())
  body String

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  callId String?
  call   Call?   @relation(fields: [callId], references: [id], onDelete: SetNull)

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  /// Set when this note schedules a callback.
  callbackAt DateTime?

  createdAt DateTime @default(now())

  @@index([contactId])
  @@index([callbackAt])
}

// ---------------------------------------------------------------------------
// Knowledge base
// ---------------------------------------------------------------------------

enum DocumentStatus {
  uploading
  processing
  ready
  failed
}

model Document {

  /// The tenant this row belongs to.
  ///
  /// Required, deliberately: a nullable column let a create quietly omit it,
  /// and such a row is invisible to every scope while — because NULL never
  /// collides in a Postgres unique index — still slipping past the composite
  /// uniques. Required makes each omission a compile error instead.
  companyId String
  tenant    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  id          String         @id @default(uuid())
  name        String
  mimeType    String
  sizeBytes   Int
  /// Object-storage key, not a public URL.
  storagePath String
  status      DocumentStatus @default(uploading)
  /// Populated when status is failed.
  error       String?

  uploadedById String?
  uploadedBy   User?   @relation("UploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chunks DocumentChunk[]

  @@index([status])
}

model DocumentChunk {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  content String
  /// Position in the source document, so retrieved chunks can be cited.
  ordinal Int    @default(0)

  /// text-embedding-3-small, 1536 dimensions, stored as a plain float array.
  ///
  /// Deliberately not pgvector. A single company's knowledge base is a few
  /// thousand chunks at most, where an exact scan in application code is both
  /// fast enough and simpler than an ANN index — and it keeps the schema
  /// runnable on any Postgres, with no extension to install first.
  embedding Float[]

  createdAt DateTime @default(now())

  @@index([documentId])
}

// ---------------------------------------------------------------------------
// WhatsApp follow-up
// ---------------------------------------------------------------------------

enum MessageStatus {
  queued
  sent
  delivered
  read
  failed
}

/// A reusable WhatsApp message body.
///
/// Bodies support {{placeholders}} — see lib/messaging/render.ts for the
/// supported set. Templates are stored rather than hardcoded so staff can add
/// and edit their own follow-ups without a deploy.
model MessageTemplate {

  /// The tenant this row belongs to.
  ///
  /// Required, deliberately: a nullable column let a create quietly omit it,
  /// and such a row is invisible to every scope while — because NULL never
  /// collides in a Postgres unique index — still slipping past the composite
  /// uniques. Required makes each omission a compile error instead.
  companyId String
  tenant    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  id   String @id @default(uuid())
  name String
  body String

  /// Offered by default after a call with this outcome. Null means the template
  /// is general-purpose and appears for every outcome.
  leadStatus LeadStatus?

  isActive Boolean @default(true)

  createdById String?
  createdBy   User?   @relation("TemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@index([leadStatus, isActive])
}

/// One WhatsApp message we attempted to deliver.
///
/// The rendered body is stored, not just the template id: templates get edited,
/// and the record of what was actually sent to a customer must not change
/// retroactively.
model Message {

  /// The tenant this row belongs to.
  ///
  /// Required, deliberately: a nullable column let a create quietly omit it,
  /// and such a row is invisible to every scope while — because NULL never
  /// collides in a Postgres unique index — still slipping past the composite
  /// uniques. Required makes each omission a compile error instead.
  companyId String
  tenant    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  id   String @id @default(uuid())
  to   String
  body String

  status MessageStatus @default(queued)
  error  String?

  /// The provider's own id, for correlating delivery webhooks.
  providerMessageId String? @unique

  templateId String?
  template   MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  callId String?
  call   Call?   @relation(fields: [callId], references: [id], onDelete: SetNull)

  sentById String?
  sentBy   User?   @relation("MessageSentBy", fields: [sentById], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  sentAt      DateTime?
  deliveredAt DateTime?

  @@index([contactId])
  @@index([status])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Platform
// ---------------------------------------------------------------------------

/// Singleton key/value configuration (default call limits, business hours,
/// company name). Avoids a migration for every new setting.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {

  /// The tenant this entry belongs to, when it has one.
  ///
  /// Nullable unlike every other model here, and for a real reason: the
  /// platform owner's own actions — approving a company, changing a plan —
  /// belong to no tenant. Requiring a company would mean inventing one for
  /// events that genuinely have none.
  companyId String?
  tenant    Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  id       String  @id @default(uuid())
  action   String
  entity   String
  entityId String?
  meta     Json?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// What a call claimed about a customer, and whether anyone has agreed with it.
//
// The engine's post-call extraction is a language model's reading of a phone
// call. It is useful, and it is a guess. Until now those guesses were written
// straight onto the Contact as fact: a model that mistook politeness for
// interest silently changed a lead's status, and nothing recorded that a
// machine had decided it or what it heard.
//
// A finding keeps the claim, the evidence for it, and its review state in one
// row. Nothing here changes a Contact on its own — only an APPLIED finding
// does, and applying is an act a person takes. That is the whole point: the
// CRM should contain what somebody stands behind, not what a model inferred.
// ---------------------------------------------------------------------------

enum FindingKind {
  interest // did they want the product
  objection // what they pushed back on
  next_action // what was agreed
  intent // what they actually wanted
  callback // a time they asked to be called
}

enum FindingState {
  suggested // extracted, awaiting a human
  applied // a person agreed; the contact was updated
  dismissed // a person disagreed; never suggested again
}

model CallFinding {

  /// The tenant this row belongs to.
  ///
  /// Required, deliberately: a nullable column let a create quietly omit it,
  /// and such a row is invisible to every scope while — because NULL never
  /// collides in a Postgres unique index — still slipping past the composite
  /// uniques. Required makes each omission a compile error instead.
  companyId String
  tenant    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  id String @id @default(uuid())

  callId String
  call   Call   @relation(fields: [callId], references: [id], onDelete: Cascade)

  /// Denormalised so a contact's findings can be listed without joining every
  /// call. Nullable because a manual dial to an unknown number has no contact
  /// until one is created.
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  kind  FindingKind
  /// The claim itself, in the engine's words.
  value String

  /// The words from the transcript that support the claim, when they could be
  /// located. Null means the claim is unevidenced — which is not the same as
  /// wrong, but is why it needs a person.
  quote String?

  /// True only when `quote` was found verbatim in Call.transcriptText.
  /// A model that invents a quote fails this check, so a fabricated citation
  /// cannot masquerade as evidence.
  quoteVerified Boolean @default(false)

  /// Set when the transcript contradicts the claim — an "interested" reading of
  /// a call in which the customer plainly declined. Surfaced first for review,
  /// because these are the ones that would do damage if applied blindly.
  contradicted Boolean @default(false)

  state FindingState @default(suggested)

  reviewedById String?
  reviewedBy   User?   @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One finding per kind per call: re-reconciling a call must update its
  /// reading, not stack a second copy of it.
  @@unique([callId, kind])
  @@index([contactId, state])
  @@index([state, contradicted])
}

// ===========================================================================
// BILLING
//
// Money is stored in the currency's minor unit — paise for INR — as integers.
// Never as Float: 0.1 + 0.2 is not 0.3 in binary floating point, and an
// invoice that disagrees with the sum of its payments by a rounding error is
// an accounting problem, not a display one. Every amount below is an integer
// count of paise, and only the presentation layer divides by 100.
//
// The database is the source of truth for balances. `Invoice.dueAmount` is
// maintained here from the payments and refunds actually recorded, so no
// screen ever computes what is owed — a figure derived twice is a figure that
// will eventually disagree with itself.
// ===========================================================================

enum BillingCycle {
  monthly
  quarterly
  yearly
  /// Charged once, for setup fees and bespoke work.
  one_time
}

enum InvoiceStatus {
  draft
  issued
  partially_paid
  paid
  /// Derived, never set by hand: past due date with an outstanding balance.
  overdue
  cancelled
}

enum PaymentStatus {
  pending
  success
  failed
  refunded
  partially_refunded
}

/// Where a payment came from. `manual` marks money recorded by a human rather
/// than confirmed by a gateway, so reconciliation can tell the two apart.
enum PaymentSource {
  gateway
  manual
}

enum SubscriptionStatus {
  trial
  active
  past_due
  paused
  cancelled
  expired
}

enum RefundStatus {
  pending
  processed
  failed
}

/// A sellable plan. Prices are per billing cycle, in minor units.
model Plan {
  id   String @id @default(uuid())
  name String
  slug String @unique

  /// Minor units (paise). 25000 rupees is 2_500_000.
  priceMinor Int
  currency   String       @default("INR")
  cycle      BillingCycle @default(monthly)

  description String?
  isActive    Boolean @default(true)
  /// Ordering in the pricing table; lower shows first.
  sortOrder   Int     @default(0)

  // Limits granted by this plan. Null means no ceiling, matching Company.
  maxUsers       Int?
  maxAgents      Int?
  maxCampaigns   Int?
  maxContacts    Int?
  maxCallsPerDay Int?
  maxCallMinutes Int?
  maxConcurrent  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
  invoices      Invoice[]

  @@index([isActive, sortOrder])
}

/// What a company is currently signed up to.
model Subscription {
  id String @id @default(uuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  status SubscriptionStatus @default(active)
  cycle  BillingCycle       @default(monthly)

  /// The agreed price, copied from the plan at signup. A later price change to
  /// the plan must not silently reprice an existing customer.
  priceMinor Int
  currency   String @default("INR")

  startedAt      DateTime  @default(now())
  currentEnd     DateTime?
  nextBillingAt  DateTime?
  cancelledAt    DateTime?
  autoRenew      Boolean   @default(true)

  /// The gateway's own subscription id, when one exists.
  gatewayRef String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[]

  @@index([companyId, status])
  @@index([nextBillingAt])
}

model Invoice {
  id String @id @default(uuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  planId String?
  plan   Plan?   @relation(fields: [planId], references: [id], onDelete: SetNull)

  /// Human-facing, sequential and unique: INV-2026-00124.
  number String @unique

  status InvoiceStatus @default(draft)

  // --- money, all minor units ----------------------------------------------
  subtotalMinor Int
  discountMinor Int @default(0)
  taxMinor      Int @default(0)
  totalMinor    Int
  paidMinor     Int @default(0)
  refundedMinor Int @default(0)
  /// total - paid + refunded. Maintained by the server so no screen recomputes
  /// it; a balance derived in two places eventually disagrees with itself.
  dueMinor      Int
  currency      String @default("INR")

  // --- tax breakdown, so an Indian invoice can show CGST/SGST or IGST ------
  cgstMinor Int @default(0)
  sgstMinor Int @default(0)
  igstMinor Int @default(0)
  taxRate   Float?

  periodStart DateTime?
  periodEnd   DateTime?
  issueDate   DateTime  @default(now())
  dueDate     DateTime
  paidAt      DateTime?
  cancelledAt DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     InvoiceItem[]
  payments  Payment[]
  refunds   Refund[]
  reminders PaymentReminder[]

  @@index([companyId, status])
  @@index([status, dueDate])
  @@index([dueDate])
}

model InvoiceItem {
  id String @id @default(uuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description String
  quantity    Int    @default(1)
  unitMinor   Int
  amountMinor Int

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

model Payment {
  id String @id @default(uuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Nullable: a gateway can send money that matches no invoice, and that is
  /// precisely the case reconciliation must surface rather than discard.
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  amountMinor   Int
  refundedMinor Int    @default(0)
  currency      String @default("INR")

  status PaymentStatus @default(pending)
  source PaymentSource @default(gateway)

  gateway       String?
  /// The gateway's payment id (Razorpay `pay_…`). Unique so replaying a
  /// webhook cannot record the same money twice.
  gatewayRef    String? @unique
  paymentMethod String?

  /// Set only when source is manual: the cheque number, NEFT reference, etc.
  manualRef    String?
  recordedById String?
  recordedBy   User?   @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  paidAt    DateTime?
  failedAt  DateTime?
  /// The gateway's own failure text, kept verbatim for support.
  failureReason String?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refunds Refund[]

  @@index([companyId, status])
  @@index([invoiceId])
  @@index([paidAt])
}

model Refund {
  id String @id @default(uuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  amountMinor Int
  currency    String @default("INR")
  reason      String?

  status RefundStatus @default(pending)
  /// The gateway's refund id. Unique for the same replay reason as payments.
  gatewayRef String? @unique

  processedById String?
  processedBy   User?   @relation("RefundProcessedBy", fields: [processedById], references: [id], onDelete: SetNull)

  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([companyId, status])
  @@index([paymentId])
}

/// One row per reminder actually sent, so a schedule change cannot cause a
/// customer to be chased twice for the same stage.
model PaymentReminder {
  id String @id @default(uuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  /// Days relative to the due date: -7 is a week before, +3 is three days late.
  offsetDays Int
  sentAt     DateTime @default(now())
  channel    String   @default("email")

  @@unique([invoiceId, offsetDays])
  @@index([invoiceId])
}

/// Every gateway event we have already handled.
///
/// Gateways retry, and a retried `payment.captured` must not record the money a
/// second time. The unique event id is what makes handling idempotent.
model BillingEvent {
  id String @id @default(uuid())

  gateway String
  /// The gateway's event id.
  eventId String
  type    String

  payload    Json
  handledAt  DateTime?
  error      String?

  createdAt DateTime @default(now())

  @@unique([gateway, eventId])
  @@index([type, createdAt])
}
