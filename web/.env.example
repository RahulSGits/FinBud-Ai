# ---------------------------------------------------------------------------
# Core — required
# ---------------------------------------------------------------------------
# Postgres. On Supabase: Project Settings -> Database -> Connection string.
# DATABASE_URL uses the pooler (port 6543); DIRECT_URL is the direct connection
# (port 5432) that `prisma migrate` needs.
DATABASE_URL="postgresql://user:pass@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:pass@host:5432/postgres"

# Signs session cookies. Must be at least 32 characters — the app refuses to
# issue a session without it. Generate with: openssl rand -hex 32
AUTH_SECRET=""

# Public base URL. Used for invite links and the webhook URL handed to voice
# providers. Must be https and reachable in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Mock mode
# ---------------------------------------------------------------------------
# When true, every voice provider resolves to the built-in mock adapter: no
# external API calls, no spend, no telephony. Calls are simulated end to end
# (ringing -> in progress -> transcript -> summary/outcome) so campaigns, call
# logs and analytics can be exercised with zero paid keys.
USE_MOCK_CALLS=true

# ---------------------------------------------------------------------------
# Voice engine — LiveKit
# ---------------------------------------------------------------------------
# Written by `lk app env`. LIVEKIT_SIP_TRUNK_ID is additionally required before
# outbound calls can be placed.
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
LIVEKIT_SIP_TRUNK_ID=""
# Must match the agent_name registered in agent/src/agent.py.
LIVEKIT_AGENT_NAME="finbud-agent"

# Shared secret for the server-to-server endpoints the LiveKit worker calls
# (/api/internal/*). Must match FINBUD_INTERNAL_SECRET in agent/.env.local.
FINBUD_INTERNAL_SECRET=""

# Default engine when an agent doesn't specify one: livekit | omnidimension.
# Ignored while USE_MOCK_CALLS=true.
VOICE_PROVIDER="livekit"

# Alternative provider — also sells +91 (India) numbers directly.
OMNIDIM_API_KEY=""

# ---------------------------------------------------------------------------
# AI — agent authoring and knowledge base
# ---------------------------------------------------------------------------
# Powers "describe your agent and go", per-section Enhance, and knowledge-base
# embeddings. Without it those features report themselves unavailable; the rest
# of the app works normally.
OPENAI_API_KEY=""
PROMPT_AI_MODEL="gpt-4o-mini"

# ---------------------------------------------------------------------------
# Email — invitations only
# ---------------------------------------------------------------------------
# Without a key, invites still work: the app hands the admin the link to pass on
# manually instead of claiming an email was sent.
RESEND_API_KEY=""
RESEND_FROM="FinBud AI <onboarding@resend.dev>"

# ---------------------------------------------------------------------------
# Scheduler
# ---------------------------------------------------------------------------
# Lets an external cron POST /api/campaigns/tick without a session, using the
# x-cron-secret header. Optional — the dashboard also ticks while it is open.
CRON_SECRET=""

# ---------------------------------------------------------------------------
# WhatsApp follow-up (Meta Cloud API)
# ---------------------------------------------------------------------------
# While USE_MOCK_CALLS=true, messages are simulated and never reach Meta, so
# templates, the preview, sending and delivery status all work without a
# WhatsApp Business account. WHATSAPP_VERIFY_TOKEN is any string you choose;
# enter the same value in Meta's webhook configuration.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""

# ---------------------------------------------------------------------------
# Supabase (optional)
# ---------------------------------------------------------------------------
# Only needed if you reach Supabase's own APIs. The app itself talks to Postgres
# through Prisma via DATABASE_URL above.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
