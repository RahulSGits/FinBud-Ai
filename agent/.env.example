# ---------------------------------------------------------------------------
# LiveKit — populate after `lk cloud auth`, e.g. via `lk app env -w .env.local`
# ---------------------------------------------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---------------------------------------------------------------------------
# FinBud backend
# ---------------------------------------------------------------------------
# Where the agent fetches its configuration and posts call results.
FINBUD_API_URL=http://localhost:3000

# Shared secret for the internal endpoints. Must match FINBUD_INTERNAL_SECRET
# in the web app. Generate with: openssl rand -hex 32
FINBUD_INTERNAL_SECRET=

# ---------------------------------------------------------------------------
# Model providers (optional)
# ---------------------------------------------------------------------------
# LiveKit Inference proxies STT/LLM/TTS by default, so these are only needed if
# you want your own billing or a provider LiveKit does not proxy.
# OPENAI_API_KEY=
# DEEPGRAM_API_KEY=
# CARTESIA_API_KEY=
